# Unity-generated folders, at the root or inside a Unity project subdirectory.
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Bb]uild/
[Bb]uilds/
[Mm]emoryCaptures/
[Rr]ecordings/

# IDE-generated files.
.vs/
.idea/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj

# Python-generated caches.
__pycache__/
*.py[cod]

# OS files.
.DS_Store
Thumbs.db
Desktop.ini

# Crash reports.
sysinfo.txt
*.stackdump

# Local secrets.
.env
.env.*
!.env.example

# Mixamo permits game use, but not public redistribution of raw assets.
# Keep import metadata and source records so locally restored assets retain GUIDs.
/Assets/ThirdParty/Mixamo/**/*.fbx
/Assets/ThirdParty/Mixamo/**/*.png

# Unity Asset Store source assets stay local under the store EULA.
/Assets/polyperfect/
/Assets/polyperfect.meta

# Local documentation and validation records.
/docs/

# Local asset and packaging utilities.
/tools/
